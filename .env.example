# 服务端管理员密钥（建议使用 openssl rand -hex 32 生成）
ADMIN_KEY=replace-with-a-random-secret-at-least-32-chars

# 可选：使用加盐 PBKDF2-SHA256 哈希作为后台登录密码；配置后不再允许 ADMIN_KEY 登录
# 格式：pbkdf2_sha256$600000$<32位十六进制盐>$<64位十六进制摘要>
# 不要在此文件或源码中填写明文密码
# ADMIN_PASSWORD_HASH=

# 会话签名密钥，不能与 ADMIN_KEY 共用
SESSION_SECRET=replace-with-another-random-secret-at-least-32-chars

# 数据库路径
DATABASE_URL=sqlite+aiosqlite:///./data/license.db
DATA_DIR=./data

# 心跳频率、在线判定和绑定保留时间分别配置（秒）
HEARTBEAT_INTERVAL=60
ONLINE_TIMEOUT=180
DEVICE_BINDING_TTL=900
# 旧 HEARTBEAT_TIMEOUT 仅在未设置 ONLINE_TIMEOUT 时作为在线判定的兼容值

# 同一公司/VPN出口的每分钟总请求上限；有效卡密再按“卡密+设备”限制
VERIFY_IP_LIMIT=1200
HEARTBEAT_IP_LIMIT=6000
VERIFY_DEVICE_LIMIT=12
HEARTBEAT_DEVICE_LIMIT=12
INVALID_LICENSE_IP_LIMIT=120

# 客户端验证/心跳日志保留最近 24 小时，每分钟自动清理
HEARTBEAT_LOG_RETENTION_DAYS=1

# 管理后台登录有效期（秒），默认 30 天；密码本身不会过期
SESSION_TTL=2592000

# HTTPS 部署时设置为 true；本地 HTTP 开发设置为 false
COOKIE_SECURE=false

# 服务端签名私钥；不存在时会在持久化 data 目录自动生成
SIGNING_PRIVATE_KEY_PATH=./data/license_private.pem

# 完整卡密加密展示密钥：自动生成，必须与数据库一起备份，不得随意更换
LICENSE_DISPLAY_KEY_PATH=./data/license_display.key

HOST=0.0.0.0
PORT=9000
